    "ci": "npm ci && npm run typecheck && npm run build && npm test && npm audit --omit=dev --audit-level=moderate"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "typescript": "^5.5.4",
    "vitest": "^4.1.9"
  }
}
